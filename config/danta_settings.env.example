# 단타분봉수집기 설정. 이 파일을 danta_settings.env로 복사해 고쳐 쓴다. 키는 여기에 넣지 않는다 (secret/keys.env).
# DATA_DIR=            # 비우면 바탕화면/단타분석
# SOURCE_DB=           # 비우면 바탕화면/주식데이터수집/db/market.sqlite (읽기 전용으로만 연다)
MARKET=J
PW_DATA_INCU_YN=N
RATE=10
BACKOFF_RETRIES=5
TOP_VALUE=100
TOP_CHANGE=50
RATETEST_STAGES=5,10,15,20,25,30
RATETEST_SECONDS=20
MAX_FAILURES=20
# probe에서 acml_tr_pbmn이 누적으로 확인되면 Y로 바꾸고 recalc 실행
ACML_IS_CUMULATIVE=
# daily (매일 수집)
DAILY_RATE=5
MAX_RETRY=3
COLLECTOR_WAIT_MINUTES=60
# THEME_FILE=          # 비우면 기존 수집기 데이터 폴더/themes/theme_master.csv
# COLLECTOR_LOCK=      # 비우면 기존 수집기 데이터 폴더/system/collector.lock
