# 토스단타 매매 설정. 이 파일을 trade_settings.env로 복사해 고쳐 쓴다. 키는 여기에 넣지 않는다.
# --- 한도 (원) : 사용자 결정 2026-11-24 ---
SEED_KRW=1000000
ORDER_KRW=200000          # 1회 주문 금액
MAX_POSITIONS=5           # 동시 보유 종목
DAILY_LOSS_KRW=50000      # 하루 손실 한도: 닿으면 그날 신규 진입 중단·전량 청산
TOTAL_LOSS_KRW=500000     # 누적 손실 한도: 닿으면 매매 해제
MAX_ORDERS_PER_DAY=40
MAX_ENTRIES_PER_CODE=1
# --- 비용 (확인 필요: 실제 수수료는 commissions API로 확정) ---
BUY_COST_RATE=0.00015
SELL_COST_RATE=0.00215
SLIPPAGE_TICKS=1
# --- 관심종목 (분석 W7) ---
WATCH_MAX=20
WATCH_VR_MIN=5
WATCH_RET_MIN=0.10
WATCH_HIGH20_VR_MIN=3
WATCH_RET_MAX=0.295
WATCH_MIN_VALUE_KRW=1000000000
WATCH_MIN_PRICE=1000
# --- 전략: 시가 범위 돌파 (t = 봉 시작 시각, 0시부터 분: 09:00=540) ---
OR_START=540
OR_END=569
ENTRY_UNTIL=900
STOP_PCT=0.03
TAKE_PROFIT_PCT=0.03      # 0이면 익절 없음
EXIT_T=919
