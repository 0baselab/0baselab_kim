# 토스측정 설정. 이 파일을 toss_settings.env로 복사해 고쳐 쓴다. 키는 여기에 넣지 않는다 (secret/keys.env).
# DATA_DIR=            # 비우면 바탕화면/단타분석 (단타분봉수집기와 같은 폴더)
# DANTA_DB=            # 비우면 DATA_DIR/danta.sqlite (읽기 전용으로만 연다)
RATE_FACTOR=0.5        # 문서 한도(그룹별 초당 호출 수)의 몇 배로 호출할지. 기본 절반
RETRY_429=5            # 429(한도 초과) 재시도 횟수. Retry-After만큼 기다린다
MAX_CALLS=3000         # candles-depth·market 과거 탐색 1회당 호출 상한
MAX_YEARS=3            # 과거 탐색 중단 기준 (년)
